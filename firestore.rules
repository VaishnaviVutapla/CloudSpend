rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { match /transactions/{id} { allow read: if request.auth != null && resource.data.userId == request.auth.uid; allow create: if request.auth != null && request.resource.data.userId == request.auth.uid; allow update,delete: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid; } match /budgets/{id} { allow read: if request.auth != null && resource.data.userId == request.auth.uid; allow create: if request.auth != null && request.resource.data.userId == request.auth.uid; allow update,delete: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid; } match /users/{id} { allow read,write: if request.auth != null && request.auth.uid == id; } }}